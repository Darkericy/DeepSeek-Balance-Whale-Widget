<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="余额看板设置" Width="426" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource Paper}" FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True">
  <DockPanel Margin="18,15,18,14">
    <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="Feedback" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,10,0"/>
      <Button Grid.Column="1" x:Name="Save" Content="保存设置" Style="{StaticResource Primary}" IsDefault="True"/>
    </Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Top">
      <StackPanel>
        <TextBlock Text="账户连接" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,9"/>
        <Border Style="{StaticResource Panel}"><StackPanel>
          <DockPanel><Button DockPanel.Dock="Right" x:Name="GetKey" Content="获取密钥 ↗" Background="Transparent" BorderBrush="Transparent" Padding="5,2"/>
            <TextBlock Text="DeepSeek" Style="{StaticResource Section}" VerticalAlignment="Center"/></DockPanel>
          <TextBlock x:Name="KeyHint" Style="{StaticResource Hint}" Margin="0,4,0,6"/>
          <PasswordBox x:Name="ApiKey" AutomationProperties.Name="DeepSeek API Key" MaxLength="4096" Height="29"/>
          <CheckBox x:Name="RemoveKey" Content="移除已保存的密钥" Margin="0,6,0,0"/>
          <Border Height="1" Background="{StaticResource Line}" Margin="0,12,0,10"/>
          <DockPanel><Button x:Name="Login" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="7,0,0,0"/>
            <StackPanel><TextBlock Text="千问 AI" Style="{StaticResource Section}"/><TextBlock x:Name="QHint" Style="{StaticResource Hint}" Margin="0,3,0,0"/></StackPanel></DockPanel>
          <CheckBox x:Name="QianwenDirect" Content="直连千问" ToolTip="授权和余额查询直接连接千问，可用于本机代理已关闭或更换端口的情况。" Margin="0,7,0,0"/>
          <CheckBox x:Name="DisableQ" Content="暂停千问监控" Margin="0,7,0,0"/>
        </StackPanel></Border>
        <TextBlock Text="桌面与提醒" FontSize="19" FontWeight="SemiBold" Margin="0,15,0,8"/>
        <Border Style="{StaticResource Panel}"><StackPanel>
          <DockPanel><ComboBox x:Name="Interval" DockPanel.Dock="Right" Width="96" Height="26" AutomationProperties.Name="自动刷新间隔"/>
            <TextBlock Text="刷新间隔" VerticalAlignment="Center"/></DockPanel>
          <CheckBox x:Name="AutoStart" Content="登录 Windows 时打开看板" Margin="0,10,0,0"/>
          <Border Height="1" Background="{StaticResource Line}" Margin="0,11,0,9"/>
          <CheckBox x:Name="Alerts" Content="余额降至提醒线时通知我"/>
          <UniformGrid x:Name="Limits" Columns="2" Margin="0,7,0,0">
            <DockPanel Margin="0,0,7,0"><TextBlock Text="人民币 ¥" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="Yuan" AutomationProperties.Name="人民币提醒线"/></DockPanel>
            <DockPanel><TextBlock Text="美元 $" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="Dollar" AutomationProperties.Name="美元提醒线"/></DockPanel>
          </UniformGrid>
        </StackPanel></Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
