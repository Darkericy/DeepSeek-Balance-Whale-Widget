<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        BorderThickness="0,0,0,1" BorderBrush="#E5D9C6" Padding="0,7,0,7">
  <StackPanel>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border x:Name="Badge" Width="27" Height="27" CornerRadius="9" VerticalAlignment="Center" Margin="0,0,7,0">
          <Path x:Name="Mark" Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.65" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Border>
        <StackPanel>
          <TextBlock x:Name="Provider" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Ink}"/>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,1,0,0"><Ellipse x:Name="Dot" Width="5" Height="5" Margin="0,0,4,0"/>
            <TextBlock x:Name="Status" FontSize="10" VerticalAlignment="Center"/>
            <Button x:Name="KeyUsage" Content="Key 用量 ›" Style="{StaticResource TextAction}" FontSize="10.5"
                    Margin="5,0,0,0" Padding="1,0" Visibility="Collapsed" ToolTip="登录 DeepSeek 官方平台，按 API Key 查看用量"
                    AutomationProperties.Name="查看各 DeepSeek API Key 的用量"/>
          </StackPanel>
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
        <StackPanel x:Name="Amounts"/>
        <Button x:Name="Connect" HorizontalAlignment="Right" Padding="8,3" FontSize="11" Background="#FAEDDF" BorderBrush="#DDC5AF" Foreground="{StaticResource Accent}"/>
      </StackPanel>
    </Grid>
    <StackPanel x:Name="Breakdown"/>
    <TextBlock x:Name="Message" Style="{StaticResource Hint}" FontSize="11" Margin="0,4,0,0"/>
    <TextBlock x:Name="Stamp" Style="{StaticResource Hint}" FontSize="10.5" Margin="0,3,0,0"/>
  </StackPanel>
</Border>
