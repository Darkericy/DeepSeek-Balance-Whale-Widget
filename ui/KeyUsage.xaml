<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeepSeek · Key 用量" Width="1000" Height="720" MinWidth="360" MinHeight="260" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="{StaticResource Paper}" FontFamily="{StaticResource UiFont}" UseLayoutRounding="True">
  <DockPanel>
    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="12,7">
      <DockPanel>
        <Button x:Name="Reload" DockPanel.Dock="Right" Content="刷新用量" IsEnabled="False" Margin="8,0,0,0"/>
        <TextBlock x:Name="Origin" VerticalAlignment="Center" Foreground="{StaticResource Ink}"
                   TextTrimming="CharacterEllipsis" AutomationProperties.Name="当前网站"/>
      </DockPanel>
    </Border>
    <StackPanel x:Name="Notice" DockPanel.Dock="Top" Margin="12,8">
      <TextBlock x:Name="Status" Style="{StaticResource Hint}" Text="正在打开 DeepSeek 官方用量页…"/>
      <Button x:Name="RuntimeDownload" Content="获取 Microsoft Edge WebView2 运行时 ↗" Style="{StaticResource TextAction}"
              HorizontalAlignment="Left" Margin="0,5,0,0" Visibility="Collapsed"/>
    </StackPanel>
    <Border x:Name="BrowserHost" Background="White"/>
  </DockPanel>
</Window>
